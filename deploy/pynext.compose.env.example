# 설정값을 적는 예제다. 실제 비밀번호와 키를 채운 파일은 따로 보관한다.
# 실행할 PyNext 프로그램이 담긴 Docker 이미지 이름이다.
PYNEXT_APP_IMAGE=gwgcommunity-pynext:release-20261115
# 이 컴퓨터에서 PyNext 서버로 연결할 포트 번호다.
PYNEXT_APP_PORT=18083
# 서버 실행에 필요한 실제 설정값을 읽을 비공개 파일의 경로다.
PYNEXT_ENV_FILE=.env.pynext
# 기존 데이터베이스에 접속할 때 참여할 Docker 네트워크 이름이다.
PYNEXT_DATABASE_NETWORK=gwgcommunity-python_default
