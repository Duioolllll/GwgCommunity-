# Example only. Add the existing TLS certificate and replace the hostname.
# Use Cloudflare's maintained IP ranges with nginx real_ip only after validating
# that Nginx is reachable solely via Cloudflare. Never trust arbitrary clients.
server {
    listen 127.0.0.1:8080;
    server_name community.example.com;
    client_max_body_size 22m;
    # Verification and password-reset URLs contain short-lived tokens.
    location ^~ /auth/ {
        access_log off;
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
