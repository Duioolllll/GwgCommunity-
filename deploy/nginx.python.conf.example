# Shared connections to the threaded Gunicorn workers.
upstream gwg_python {
    server 127.0.0.1:18080;
    keepalive 16;
}

# Prepared for the existing community.example.com TLS setup. Install only after the
# Django service on 127.0.0.1:18080 and its separate database are verified.
server {
    listen 80;
    listen [::]:80;
    server_name community.example.com www.community.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name community.example.com www.community.example.com;

    ssl_certificate /etc/nginx/ssl/origin.pem;
    ssl_certificate_key /etc/nginx/ssl/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20M;

    # Verification and password-reset links contain tokens.
    location ^~ /auth/ {
        access_log off;
        proxy_pass http://gwg_python;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://gwg_python;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
