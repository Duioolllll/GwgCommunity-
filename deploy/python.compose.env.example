# 설정값을 적는 예제다. 실제 비밀번호와 키를 채운 파일은 따로 보관한다.
# 실행할 Django 프로그램이 담긴 Docker 이미지 이름이다.
PYTHON_APP_IMAGE=gwgcommunity-python:local
# Django의 실제 설정값을 읽을 비공개 파일의 경로다.
PYTHON_ENV_FILE=/absolute/path/to/secure-python-app.env
# 이 컴퓨터에서 Django 서버로 연결할 포트 번호다.
PYTHON_APP_PORT=18080
# 데이터베이스에 로그인할 계정 이름이다.
PYTHON_DB_USER=gwg
# 서비스 데이터를 저장할 데이터베이스 이름이다.
PYTHON_DB_NAME=gwg_python
# 데이터베이스 계정의 비밀번호다. 실제 값은 따로 보관한다.
PYTHON_DB_PASSWORD=
