# 설정값을 적는 예제다. 실제 비밀번호와 키를 채운 파일은 따로 보관한다.
# 개발 중 오류 화면을 보여 줄지 정한다. 실제 서비스에서는 0으로 둔다.
DJANGO_DEBUG=0
# 로그인 정보와 확인 링크가 위조되지 않도록 지키는 서버 전용 비밀값이다.
DJANGO_SECRET_KEY=
# 초대 코드 원문 대신 비교용 값을 만들 때 쓰는 비밀값이다.
DJANGO_INVITATION_SECRET=
# 회원·게시글 등을 저장할 PostgreSQL 데이터베이스의 연결 주소다.
DJANGO_DATABASE_URL=
# 이 서버로 접속을 허용할 도메인 이름을 적는다.
DJANGO_ALLOWED_HOSTS=
# 글 저장 등의 요청을 보낼 수 있는 사이트 주소를 적는다.
DJANGO_CSRF_TRUSTED_ORIGINS=
# 접속자 정보를 대신 전달해도 된다고 믿을 앞단 서버의 IP를 적는다.
DJANGO_TRUSTED_PROXY_IPS=
# 앞단 서버가 알려 주는 HTTPS 사용 여부를 믿을지 정한다.
DJANGO_TRUST_FORWARDED_PROTO=0
# 켜면 암호화되지 않은 HTTP 접속을 HTTPS로 보낸다.
DJANGO_SECURE_SSL_REDIRECT=0
# 브라우저가 앞으로 HTTPS로만 접속하도록 기억할 시간을 초 단위로 정한다.
DJANGO_HSTS_SECONDS=0
# 이메일 확인·비밀번호 재설정 메일을 보낼 메일 서버 주소다.
SMTP_HOST=
# 메일 서버에 연결할 포트 번호다.
SMTP_PORT=587
# 메일 발송에 사용할 계정 이름이다.
SMTP_USER=
# 메일 발송 계정의 비밀번호다. 실제 값은 공개 저장소에 올리지 않는다.
SMTP_PASSWORD=
# 받는 사람에게 표시할 발신자 이메일 주소다.
SMTP_FROM=
# 연결 후 암호화 통신으로 바꾸는 방식을 사용할지 정한다.
SMTP_TLS=1
# 처음 연결할 때부터 암호화 통신을 사용할지 정한다.
SMTP_SSL=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
