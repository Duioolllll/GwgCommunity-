# Copy to an access-restricted file outside version control.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_INVITATION_SECRET=
DJANGO_DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only set these after Nginx overwrites and protects the corresponding headers.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_TRUST_FORWARDED_PROTO=0
# Enable only after confirming the proxy and HTTPS configuration.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
