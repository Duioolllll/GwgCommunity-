# Copy to deploy/.env. Never commit filled credentials.
APP_IMAGE=gwgcommunity:ubuntu
MIGRATION_IMAGE=gwgcommunity:migrations
APP_PORT=3000
POSTGRES_DB=gwg
POSTGRES_USER=gwg
# Generate a password with openssl rand -hex 24 and use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gwg:REPLACE_DB_PASSWORD@db:5432/gwg
# Generate each secret independently with openssl rand -hex 32.
BETTER_AUTH_SECRET=
INVITATION_SECRET=
BETTER_AUTH_URL=https://community.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Reuse your connected private R2 bucket's settings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
