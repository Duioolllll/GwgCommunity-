# 요청을 넘겨줄 실제 웹 프로그램의 주소를 묶어 이름을 붙인다.
upstream gwg_python {
    # 앱의 접속 주소를 정하거나 아래에 웹사이트의 접속 규칙을 묶는다.
    server 127.0.0.1:18080;
    # 앱과의 연결 일부를 유지해 다음 요청 때 다시 사용한다.
    keepalive 16;
}

# 앱의 접속 주소를 정하거나 아래에 웹사이트의 접속 규칙을 묶는다.
server {
    # 브라우저 요청을 받을 포트다. 443은 인증서를 사용하는 HTTPS 연결이다.
    listen 80;
    # 브라우저 요청을 받을 포트다. 443은 인증서를 사용하는 HTTPS 연결이다.
    listen [::]:80;
    # 이 설정으로 받을 도메인 이름이다.
    server_name sunmyxd.tech www.sunmyxd.tech;

    # HTTP로 들어온 요청을 같은 경로의 HTTPS 주소로 다시 보낸다.
    return 301 https://$host$request_uri;
}

# 앱의 접속 주소를 정하거나 아래에 웹사이트의 접속 규칙을 묶는다.
server {
    # 브라우저 요청을 받을 포트다. 443은 인증서를 사용하는 HTTPS 연결이다.
    listen 443 ssl;
    # 브라우저 요청을 받을 포트다. 443은 인증서를 사용하는 HTTPS 연결이다.
    listen [::]:443 ssl;
    # 이 설정으로 받을 도메인 이름이다.
    server_name sunmyxd.tech www.sunmyxd.tech;

    # HTTPS 연결에 사용할 인증서 파일의 위치다.
    ssl_certificate /etc/nginx/ssl/origin.pem;
    # 인증서에 대응하는 비밀 키 파일의 위치다.
    ssl_certificate_key /etc/nginx/ssl/origin.key;
    # 허용할 암호화 통신 버전을 정한다.
    ssl_protocols TLSv1.2 TLSv1.3;
    # 한 요청에 담을 수 있는 업로드 데이터의 최대 크기다.
    client_max_body_size 20M;

    # 요청 주소에 따라 아래 전달 규칙을 적용한다.
    location ^~ /auth/ {
        # 접속 기록을 남길 위치를 정한다. off이면 민감한 확인 링크가 기록되지 않게 끈다.
        access_log off;
        # 이 요청을 실제 웹 프로그램에 넘겨서 처리하게 한다.
        proxy_pass http://gwg_python;
        # 웹 프로그램과 통신할 때 HTTP 1.1을 사용한다.
        proxy_http_version 1.1;
        # 연결을 재사용할 수 있도록 불필요한 연결 지시를 없앤다.
        proxy_set_header Connection "";
        # 원래 요청한 도메인을 앱에 알려 준다.
        proxy_set_header Host $host;
        # 실제 접속자의 IP를 앱에 알려 준다.
        proxy_set_header X-Real-IP $remote_addr;
        # 접속자 IP를 이 앞단 서버가 확인한 값으로 다시 적어 전달한다.
        proxy_set_header X-Forwarded-For $remote_addr;
        # 브라우저가 HTTPS로 접속했다는 사실을 앱에 알려 준다.
        proxy_set_header X-Forwarded-Proto https;
        # 웹 프로그램의 응답을 기다릴 최대 시간이다.
        proxy_read_timeout 60s;
    }

    # 요청 주소에 따라 아래 전달 규칙을 적용한다.
    location / {
        # 이 요청을 실제 웹 프로그램에 넘겨서 처리하게 한다.
        proxy_pass http://gwg_python;
        # 웹 프로그램과 통신할 때 HTTP 1.1을 사용한다.
        proxy_http_version 1.1;
        # 연결을 재사용할 수 있도록 불필요한 연결 지시를 없앤다.
        proxy_set_header Connection "";
        # 원래 요청한 도메인을 앱에 알려 준다.
        proxy_set_header Host $host;
        # 실제 접속자의 IP를 앱에 알려 준다.
        proxy_set_header X-Real-IP $remote_addr;
        # 접속자 IP를 이 앞단 서버가 확인한 값으로 다시 적어 전달한다.
        proxy_set_header X-Forwarded-For $remote_addr;
        # 브라우저가 HTTPS로 접속했다는 사실을 앱에 알려 준다.
        proxy_set_header X-Forwarded-Proto https;
        # 웹 프로그램의 응답을 기다릴 최대 시간이다.
        proxy_read_timeout 60s;
    }
}
