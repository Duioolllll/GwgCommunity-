# 실제 비밀값은 Git 밖의 접근 제한된 파일에 복사해서 입력한다.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_INVITATION_SECRET=
DJANGO_DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Nginx가 접속 정보를 안전하게 덮어쓰도록 설정한 뒤에만 아래 전달 정보 옵션을 켠다.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_TRUST_FORWARDED_PROTO=0
# 중계 서버와 HTTPS 설정을 확인한 뒤에만 보안 연결 강제 옵션을 켠다.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# 서버 기록의 자세한 정도를 정한다. 운영 중 일반 기록에는 요청별 식별정보를 남기지 않는다.
PYNEXT_LOG_LEVEL=WARNING
