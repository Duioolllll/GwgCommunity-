    "next": "^15.5.7",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
